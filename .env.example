# SurvAI API Configuration
SURVAI_API_BASE_URL=https://app.surv-ai.com
# OR for local development:
# SURVAI_API_BASE_URL=http://localhost:5173

# API Authentication - Use one of these:
# Option 1: API Key (recommended for production)
SURVAI_API_KEY=survai_k_your_api_key_here

# Option 2: Firebase token (for development)
# SURVAI_FIREBASE_TOKEN=your_firebase_token_here

# Webhook Configuration
WEBHOOK_PORT=3000
# For local development, use ngrok to expose your webhook endpoint:
# ngrok http 3000
# Then set this to your ngrok URL:
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# Webhook secret is provided when you register the webhook
# Will be automatically saved after registration
WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Storage
DATA_DIR=./data

# Optional: Mock mode (if SurvAI supports it)
# SURVAI_MOCK_OPENAI=true
